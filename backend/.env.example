PORT=8080
NODE_ENV=production
# Central PostgreSQL connection; must be a privileged provisioning account.
CONTROL_DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/nova_control
# At least 32 random bytes; used to encrypt per-company database credentials.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# One-time bootstrap secret for provisioning the first companies. Keep private.
SUPERADMIN_BOOTSTRAP_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://your-domain.example
